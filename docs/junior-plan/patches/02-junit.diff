-tasks.named('test') { failOnNoDiscoveredTests = false }
-// Each *Check class under src/test is a standalone main() run as part of `check`.
-fileTree('src/test/java/dev/exactselection').matching { include '*Check.java' }.each { source ->
-    String name = source.name - '.java'
-    def task = tasks.register(name[0].toLowerCase() + name.substring(1), JavaExec) {
-        dependsOn testClasses
-        classpath = sourceSets.test.runtimeClasspath
-        mainClass = "dev.exactselection.${name}"
-        enableAssertions = true
-    }
-    check.dependsOn task
+tasks.named('test') {
+    useJUnitPlatform()
+    // Each class builds its own fake Minecraft in static fields, as each check did in its own JVM.
+    forkEvery = 1
+    testLogging { events 'passed', 'skipped', 'failed' }
 }
