{
  "schemaVersion": 1,
  "id": "xaero_exact_selection",
  "version": "${version}",
  "name": "Exact Selection for Xaero's map",
  "description": "Precise rectangular and polygon selections, saved map areas, groups, and area export for Xaero's World Map.",
  "environment": "client",
  "license": "MIT",
  "icon": "assets/xaero_exact_selection/icon.png",
  "entrypoints": {
    "client": [
      "dev.exactselection.ToolKeys"
    ],
    "modmenu": [
      "dev.exactselection.ModMenuIntegration"
    ]
  },
  "mixins": [
    "xaero-exact-selection.mixins.json",
    "xaero-exact-selection-minimap.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.3",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.139.4",
    "xaeroworldmap": ">=1.40.4 <1.48.0"
  },
  "suggests": {
    "xaerominimap": ">=25.3.5"
  },
  "authors": [
    "rigalshd"
  ],
  "contact": {
    "homepage": "https://github.com/RigalHD/xaero-exact-selection",
    "sources": "https://github.com/RigalHD/xaero-exact-selection",
    "issues": "https://github.com/RigalHD/xaero-exact-selection/issues"
  }
}
